{"spec_version":"0.1-draft-2026-05","protocol":"a2a","protocol_spec":"https://a2a.dev/spec","agent":{"id":"co.curie/commerce","name":"Curie Commerce Agent","description":"Cross-merchant commerce agent for the Shopify ecosystem. Searches 5.6M+ stores, compares products, returns Wirecutter-style JTBD answers, and initiates Stripe ACP checkout. Drop into any A2A conversation that needs a shopping turn.","homepage":"https://chat.curie.app","avatar_url":"https://chat.curie.app/favicon-512.png","operator":{"legal_name":"Curie Vision, Inc.","contact":"hello@curie.co","terms":"https://chat.curie.app/terms","privacy":"https://chat.curie.app/privacy"}},"endpoints":{"rpc":"https://chat.curie.app/api/mcp/global","per_store_template":"https://chat.curie.app/api/mcp/{shop_id}","health":"https://chat.curie.app/api/version"},"capabilities":[{"intent":"product_discovery","description":"Find products matching a description across 5.6M+ Shopify stores. Returns ranked results with image, price, brand, 3D model URLs.","input_schema":{"type":"object","properties":{"query":{"type":"string"},"limit":{"type":"integer","default":12,"maximum":50},"filters":{"type":"object"}},"required":["query"]},"tool":"search_products"},{"intent":"product_comparison","description":"Side-by-side comparison of 2-6 products. Returns a comparison matrix with feature rows + cascade visual per row.","input_schema":{"type":"object","properties":{"product_ids":{"type":"array","items":{"type":"string"},"minItems":2,"maxItems":6}},"required":["product_ids"]},"tool":"compare_products"},{"intent":"jtbd_recommendation","description":"Wirecutter-style 'best X for Y' answer. Returns our_pick + 2-3 alternatives + criteria + citations.","input_schema":{"type":"object","properties":{"job_description":{"type":"string"},"constraints":{"type":"object"}},"required":["job_description"]},"tool":"solve_job"},{"intent":"3d_model_view","description":"Return an embeddable interactive 3D viewer (GLB + USDZ) for a specific product.","input_schema":{"type":"object","properties":{"product_id":{"type":"string"}},"required":["product_id"]},"tool":"view_3d_model"},{"intent":"checkout","description":"Initiate Stripe ACP checkout for one or more products. Returns a Stripe-hosted checkout URL the buyer completes inline.","input_schema":{"type":"object","properties":{"product_ids":{"type":"array","items":{"type":"string"}},"shipping_address":{"type":"object"}},"required":["product_ids"]},"tool":"initiate_checkout","auth_required":"curie:pro","payment_provider":"stripe-acp"},{"intent":"brand_voice","description":"Return a Shopify merchant's brand voice + palette + tone profile so a parent agent can speak in that merchant's voice.","input_schema":{"type":"object","properties":{"shop_domain":{"type":"string"}},"required":["shop_domain"]},"tool":"get_brand_context"}],"handoff":{"method":"mcp.tools/call","context_envelope_field":"params.arguments.handoff_context","identity_pass_through":["conversation_id","turn_id","parent_agent_id"],"completion_envelope":"result.content[].text + result._meta"},"references":{"mcp_well_known":"https://chat.curie.app/.well-known/mcp.json","commerce_well_known":"https://chat.curie.app/.well-known/commerce.json","ucp_well_known":"https://chat.curie.app/.well-known/ucp.json","registry":"https://registry.modelcontextprotocol.io/v0/servers?search=co.curie"}}